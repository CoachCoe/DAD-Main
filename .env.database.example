# Database credentials for the test-mode deployment. Do not commit this filled file.
# Compose reads it only to build each service's own setting, so no container receives
# another process's login; see docs/operations.md#database-roles.
POSTGRES_USER=impactgraph
POSTGRES_PASSWORD=
POSTGRES_DB=impactgraph
# The schema owner, used only by migrations and by provision-roles. Use the container
# hostname and URL-encode reserved characters in credentials.
DONOR_GO_DATABASE_URL=postgresql://impactgraph:CHANGE_ME@postgres:5432/impactgraph
# One login per process. provision-roles creates each user named here with its password
# and the process's pool size as its connection limit; run it again after any change.
# Generate each password separately: openssl rand -hex 32
DONOR_API_DATABASE_URL=postgresql://dad_api_login:CHANGE_ME@postgres:5432/impactgraph
DONOR_WORKER_STRIPE_DATABASE_URL=postgresql://dad_worker_stripe_login:CHANGE_ME@postgres:5432/impactgraph
DONOR_WORKER_PROJECTIONS_DATABASE_URL=postgresql://dad_worker_projections_login:CHANGE_ME@postgres:5432/impactgraph
DONOR_WORKER_LOGIN_EMAIL_DATABASE_URL=postgresql://dad_worker_login_email_login:CHANGE_ME@postgres:5432/impactgraph
DONOR_WORKER_EMAIL_CHANGES_DATABASE_URL=postgresql://dad_worker_email_changes_login:CHANGE_ME@postgres:5432/impactgraph
DONOR_WORKER_MESSAGES_DATABASE_URL=postgresql://dad_worker_messages_login:CHANGE_ME@postgres:5432/impactgraph
DONOR_WORKER_PUSH_DATABASE_URL=postgresql://dad_worker_push_login:CHANGE_ME@postgres:5432/impactgraph
DONOR_MONITOR_DATABASE_URL=postgresql://dad_monitor_login:CHANGE_ME@postgres:5432/impactgraph
DONOR_STAFF_CLI_DATABASE_URL=postgresql://dad_staff_cli_login:CHANGE_ME@postgres:5432/impactgraph
DONOR_REKEY_DATABASE_URL=postgresql://dad_rekey_login:CHANGE_ME@postgres:5432/impactgraph
