# Test-mode deployment. Do not commit this filled file.
IMAGE_PREFIX=impactgraph
# Name each build (for example the git commit) so a rollback can select the previous one.
IMAGE_TAG=
POSTGRES_USER=impactgraph
POSTGRES_PASSWORD=
POSTGRES_DB=impactgraph
# Use the container hostname and URL-encode reserved characters in credentials.
DONOR_GO_DATABASE_URL=postgresql://impactgraph:CHANGE_ME@postgres:5432/impactgraph
DONOR_PUBLIC_ORIGIN=https://donors.example.org
# The back office's own HTTPS host. It must differ from the public host; nginx serves each
# its own paths.
DONOR_STAFF_ORIGIN=https://staff.donors.example.org
# nginx overwrites this header with the client address on every request. Leave empty
# to make every visitor share one rate-limit quota.
DONOR_CLIENT_IP_HEADER=X-Real-IP
# cloudflare: only Cloudflare reaches the origin (Authenticated Origin Pulls) and names the
# client in CF-Connecting-IP. direct: clients connect to nginx themselves. See docs/edge.md.
INGRESS_MODE=cloudflare
# Host directory holding fullchain.pem and privkey.pem, readable by uid 101.
INGRESS_TLS_DIR=/etc/impactgraph/tls
# Optional: your own Authenticated Origin Pulls CA instead of Cloudflare's shared one.
# INGRESS_ORIGIN_PULL_CA=/etc/impactgraph/origin-pull-ca.pem
# Optional: nginx allow/deny rules for the staff host.
# INGRESS_STAFF_ACCESS=/etc/impactgraph/staff-access.conf
# DONOR_TRUSTED_PROXY_CIDRS is fixed by docker-compose.prod.yml to the web container.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DONOR_GO_WORKERS_ENABLED=false
# Independent 32-byte URL-safe base64 keys: openssl rand -base64 32 | tr '+/' '-_'
# During a rotation each holds a comma-separated list, new key first; keep retired keys in
# the secret store while backups need them. See docs/operations.md#encryption-keys.
DONOR_CONTENT_ENCRYPTION_KEY=
DONOR_EMAIL_ENCRYPTION_KEY=
DONOR_SMTP_HOST=
DONOR_SMTP_PORT=587
DONOR_SMTP_USERNAME=
DONOR_SMTP_PASSWORD=
DONOR_EMAIL_FROM=
API_PORT=8002
# Optional Wallet issuance. Mount private files read-only into the API container.
# Apple accepts PEM or DER certificates and an unencrypted PEM RSA private key.
DONOR_WALLET_APPLE_CERT_FILE=
DONOR_WALLET_APPLE_KEY_FILE=
DONOR_WALLET_APPLE_WWDR_FILE=
# Google service-account JSON and an existing approved Generic class ID.
DONOR_WALLET_GOOGLE_KEY_FILE=
DONOR_WALLET_GOOGLE_CLASS_ID=
# Optional app notifications; mount private files read-only into the API and push worker.
# Leave blank to disable; see docs/operations.md.
# APNs: the .p8 authentication key, its key ID, the team ID, and the app's bundle ID.
DONOR_PUSH_APNS_KEY_FILE=
DONOR_PUSH_APNS_KEY_ID=
DONOR_PUSH_APNS_TEAM_ID=
DONOR_PUSH_APNS_TOPIC=
# FCM: the Firebase service-account JSON key.
DONOR_PUSH_FCM_KEY_FILE=
