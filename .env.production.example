# Test-mode deployment behind your HTTPS reverse proxy. Do not commit this filled file.
IMAGE_PREFIX=impactgraph
IMAGE_TAG=latest
POSTGRES_USER=impactgraph
POSTGRES_PASSWORD=
POSTGRES_DB=impactgraph
# Use the container hostname and URL-encode reserved characters in credentials.
DONOR_GO_DATABASE_URL=postgresql://impactgraph:CHANGE_ME@postgres:5432/impactgraph
DONOR_PUBLIC_ORIGIN=https://donors.example.org
# Set only behind an ingress that overwrites this single-IP header and blocks bypass.
DONOR_CLIENT_IP_HEADER=
# Restrict to the web proxy's address/network, never all internet addresses.
DONOR_TRUSTED_PROXY_CIDRS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DONOR_GO_WORKERS_ENABLED=false
DONOR_STAFF_ENCRYPTION_KEY=
DONOR_CONTENT_ENCRYPTION_KEY=
DONOR_EMAIL_ENCRYPTION_KEY=
DONOR_SMTP_HOST=
DONOR_SMTP_PORT=587
DONOR_SMTP_USERNAME=
DONOR_SMTP_PASSWORD=
DONOR_EMAIL_FROM=
API_PORT=8002
WEB_PORT=3000
