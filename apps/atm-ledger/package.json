{
  "name": "dad-atm-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "biome check --error-on-warnings src test vitest.config.ts",
    "format": "biome format --write src test vitest.config.ts",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.1",
    "@types/node": "24.7.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.150.0"
  },
  "overrides": {
    "undici": "^8.12.3",
    "zod": "^4.6.6"
  }
}
