# Local R1 sandbox. Load these variables into your shell before running Go commands.
# The schema owner, which migrations use.
DONOR_GO_DATABASE_URL=postgresql://dad:dad@localhost:55432/dad
# Lets each local process connect as the owner when its own URL is unset; deployed processes
# refuse to. To run one with only its role's privileges, give it a URL that assumes the role,
# which the local superuser may: DONOR_API_DATABASE_URL=$DONOR_GO_DATABASE_URL?role=dad_api.
# See docs/operations.md#database-roles for every process's variable and role.
DONOR_ALLOW_OWNER_CONNECTION=true
DONOR_GO_LISTEN=127.0.0.1:8002
DONOR_API_BASE_URL=http://localhost:8002
DONOR_PUBLIC_ORIGIN=http://localhost:3000
# The staff back office has its own host. Browsers resolve every *.localhost name locally.
DONOR_STAFF_ORIGIN=http://staff.localhost:3000
DONOR_CLIENT_IP_HEADER=
DONOR_TRUSTED_PROXY_CIDRS=

# This release accepts only Stripe test keys. Leave blank for a read-only preview.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Enable only when deliberately starting the Go workers.
DONOR_GO_WORKERS_ENABLED=false

# Transactional email requires STARTTLS. Leave blank to disable delivery.
DONOR_SMTP_HOST=
DONOR_SMTP_PORT=587
DONOR_SMTP_USERNAME=
DONOR_SMTP_PASSWORD=
DONOR_EMAIL_FROM=
# Optional: PEM file of root certificates to trust for the STARTTLS handshake,
# replacing the system trust store. Set this for a mail server with a private
# CA — the local Mailpit capture inbox in development, or an internal relay.
# STARTTLS and full certificate verification stay mandatory; this never enables
# cleartext. For local Mailpit capture, see docs/operations.md (Capturing mail
# in development): point DONOR_SMTP_HOST=localhost, DONOR_SMTP_PORT=1025, and
# DONOR_SMTP_CA at the generated certs/mailpit.pem.
DONOR_SMTP_CA=

# Two independent URL-safe base64-encoded 32-byte encryption keys.
# Generate each separately with: openssl rand -base64 32 | tr '+/' '-_'
# During a rotation each holds a comma-separated list, new key first; see docs/operations.md.
DONOR_EMAIL_ENCRYPTION_KEY=
DONOR_CONTENT_ENCRYPTION_KEY=

# Optional Wallet issuance; see docs/wallet.md. Leave blank to disable.
DONOR_WALLET_APPLE_CERT_FILE=
DONOR_WALLET_APPLE_KEY_FILE=
DONOR_WALLET_APPLE_WWDR_FILE=
DONOR_WALLET_GOOGLE_KEY_FILE=
DONOR_WALLET_GOOGLE_CLASS_ID=

# Optional app notifications; see docs/operations.md. Leave blank to disable.
# APNs: the .p8 authentication key, its key ID, the team ID, and the app's bundle ID.
DONOR_PUSH_APNS_KEY_FILE=
DONOR_PUSH_APNS_KEY_ID=
DONOR_PUSH_APNS_TEAM_ID=
DONOR_PUSH_APNS_TOPIC=
# FCM: the Firebase service-account JSON key.
DONOR_PUSH_FCM_KEY_FILE=

# Dedicated synthetic test database, never the application database.
TEST_DATABASE_URL=postgresql://go_test:go_test@localhost:55440/donor_go
