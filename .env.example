# Local R1 sandbox. Load these variables into your shell before running Go commands.
DONOR_GO_DATABASE_URL=postgresql://impactgraph:impactgraph@localhost:55432/impactgraph
DONOR_GO_LISTEN=127.0.0.1:8002
DONOR_API_BASE_URL=http://localhost:8002
DONOR_PUBLIC_ORIGIN=http://localhost:3000
# The staff back office has its own host. Browsers resolve every *.localhost name locally.
DONOR_STAFF_ORIGIN=http://staff.localhost:3000
DONOR_CLIENT_IP_HEADER=
DONOR_TRUSTED_PROXY_CIDRS=

# This release accepts only Stripe test keys. Leave blank for a read-only preview.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Enable only when deliberately starting the Go workers.
DONOR_GO_WORKERS_ENABLED=false

# Transactional email requires STARTTLS. Leave blank to disable delivery.
DONOR_SMTP_HOST=
DONOR_SMTP_PORT=587
DONOR_SMTP_USERNAME=
DONOR_SMTP_PASSWORD=
DONOR_EMAIL_FROM=

# Two independent URL-safe base64-encoded 32-byte encryption keys.
# Generate each separately with: openssl rand -base64 32 | tr '+/' '-_'
DONOR_EMAIL_ENCRYPTION_KEY=
DONOR_CONTENT_ENCRYPTION_KEY=

# Optional Wallet issuance; see docs/wallet.md. Leave blank to disable.
DONOR_WALLET_APPLE_CERT_FILE=
DONOR_WALLET_APPLE_KEY_FILE=
DONOR_WALLET_APPLE_WWDR_FILE=
DONOR_WALLET_GOOGLE_KEY_FILE=
DONOR_WALLET_GOOGLE_CLASS_ID=

# Dedicated synthetic test database, never the application database.
TEST_DATABASE_URL=postgresql://go_test:go_test@localhost:55440/donor_go
